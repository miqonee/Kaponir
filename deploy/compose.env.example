# Generate independent values, for example with: openssl rand -hex 32
KAPONIR_API_TOKEN=replace-with-a-long-random-token
KAPONIR_WORKER_TOKEN=replace-with-another-long-random-token
KAPONIR_PORT=8787
# Directory on the Docker host, mounted read-only inside the worker:
KAPONIR_INPUT_DIR=./documents
# source = reproducible source build; prebuilt = use target/release/kaponir (Linux only)
KAPONIR_BUILD=source
