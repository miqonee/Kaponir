# Generate independent values, for example with: openssl rand -hex 32
KAPONIR_API_TOKEN=replace-with-a-long-random-token
KAPONIR_WORKER_TOKEN=replace-with-another-long-random-token
KAPONIR_PORT=8787
# Optional vault master key for the proxy. Inject KAPONIR_VAULT_KEY (64 hex digits)
# from your secret manager, or mount its text file read-only and set the path:
# KAPONIR_VAULT_KEY_FILE=/run/secrets/kaponir-master
# Leave both unset to generate vault.key in the data volume on first initialization.
# Set to false to disable the Dataset module. Unset uses config.toml.
# KAPONIR_DATASET_ENABLED=false
# Directory on the Docker host, mounted read-only inside the worker:
KAPONIR_INPUT_DIR=./documents
# source = reproducible source build; prebuilt = use target/release/kaponir (Linux only)
KAPONIR_BUILD=source
